{
  "name": "opencode-provider-quota",
  "version": "2.0.1",
  "description": "Security-conscious OpenCode v2 quota sidebar for OpenAI and GitHub Copilot.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./rpc": "./dist/rpc.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "opencode": ">=2.0.28 <3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lmasaya/opencode-provider-quota.git"
  },
  "homepage": "https://github.com/lmasaya/opencode-provider-quota#readme",
  "bugs": {
    "url": "https://github.com/lmasaya/opencode-provider-quota/issues"
  },
  "author": "lmasaya",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "quota",
    "sidebar",
    "openai",
    "copilot"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild src/index.ts src/tui.ts src/rpc.ts --bundle --format=esm --platform=node --packages=external --outdir=dist",
    "check": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:ui": "bun test --conditions=browser tests/sidebar.test.mjs"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.28",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/client": "2.0.29",
    "@opencode/plugin": "2.0.29",
    "@opencode/theme": "2.0.29",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/node": "22.13.10",
    "esbuild": "0.28.2",
    "solid-js": "1.9.17",
    "tsx": "4.20.6",
    "typescript": "5.8.3"
  },
  "overrides": {
    "@opentui/solid": {
      "solid-js": "$solid-js"
    }
  }
}
