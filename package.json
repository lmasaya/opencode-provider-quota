{
  "name": "opencode-quota",
  "version": "0.1.1",
  "description": "Security-conscious OpenCode quota sidebar for OpenAI, GitHub Copilot, and Claude.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "oc-plugin": [
    "server",
    "tui"
  ],
  "scripts": {
    "build": "esbuild src/index.ts src/tui.ts --bundle --format=esm --platform=node --packages=external --outdir=dist",
    "check": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.31",
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "esbuild": "0.28.2",
    "tsx": "4.20.6",
    "typescript": "5.8.3"
  }
}
